# =============================================================================
# PROTEIN VILLA - BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================

PORT=5000
NODE_ENV=production
DATABASE_URL="postgresql://dbadmin:SecurePassword123@protein-villa-db.xxxxxx.ap-south-1.rds.amazonaws.com:5432/proteinvilladb?schema=public"

# =============================================================================
# JWT AUTHENTICATION SECRETS
# =============================================================================
JWT_SECRET="generate_a_64_char_random_cryptographic_secret_here"
JWT_EXPIRES_IN="7d"

# CORS Origins (Allowed frontend domains)
CORS_ORIGIN="https://devopswithyogesh.online,https://www.devopswithyogesh.online"

# =============================================================================
# DIRECT BANK & PAYMENT GATEWAY AUTO-SETTLEMENT CONFIGURATION
# =============================================================================
# 1. Razorpay Payment Gateway (Settles directly to Bank Account: T+1 day)
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxx"

# 2. PhonePe / Paytm / Cashfree Merchant Gateway (Optional)
PHONEPE_MERCHANT_ID="MERCHANTUAT"
PHONEPE_SALT_KEY="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
PHONEPE_SALT_INDEX="1"

# 3. Cryptographic Payment Verification HMAC Key
PAYMENT_SECRET_KEY="generate_another_secure_payment_hmac_secret"
